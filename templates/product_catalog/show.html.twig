{% extends 'base.html.twig' %}

{% block title %}{{ product.name }}{% endblock %}

{% block body %}
{% set images = product.images|sort((a, b) => a.position <=> b.position) %}
{% set mainImage = images|first %}
{% set thumbnails = images|slice(1, 3) %}
{% set hiddenCount = images|length - 4 %}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">{{ product.name }}</h1>
        <p class="text-muted mb-0">
            Szczegóły produktu dostępnego w katalogu B2B.
        </p>
    </div>

    <a href="{{ path('app_products') }}" class="btn btn-outline-secondary">
        Powrót do katalogu
    </a>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-light">
                <h2 class="h5 mb-0">Zdjęcia produktu</h2>
            </div>

            <div class="card-body">
                {% if images|length > 0 %}
                    <div class="product-gallery">
                        <button type="button"
                                class="btn p-0 border-0 w-100"
                                data-bs-toggle="modal"
                                data-bs-target="#productGalleryModal"
                                data-bs-slide-to="0">
                            <img src="{{ asset('uploads/products/' ~ mainImage.filename) }}"
                                 class="img-fluid rounded border"
                                 alt="{{ product.name }}"
                                 style="width: 100%; height: 420px; object-fit: contain;">
                        </button>

                        {% if images|length > 1 %}
                            <div class="row g-2 mt-2">
                                {% for image in thumbnails %}
                                    {% set imageIndex = loop.index %}
                                    {% set isLastVisibleThumbnail = loop.last and hiddenCount > 0 %}

                                    <div class="col-4">
                                        <button type="button"
                                                class="btn p-0 border-0 w-100 position-relative"
                                                data-bs-toggle="modal"
                                                data-bs-target="#productGalleryModal"
                                                data-bs-slide-to="{{ imageIndex }}">
                                            <img src="{{ asset('uploads/products/' ~ image.filename) }}"
                                                 class="img-fluid rounded border"
                                                 alt="{{ product.name }}"
                                                 style="width: 100%; height: 110px; object-fit: contain;">

                                            {% if isLastVisibleThumbnail %}
                                                <div class="position-absolute top-0 start-0 w-100 h-100 rounded d-flex align-items-center justify-content-center"
                                                     style="background: rgba(0, 0, 0, 0.55);">
                                                    <span class="text-white fw-semibold fs-4">
                                                        +{{ hiddenCount }}
                                                    </span>
                                                </div>
                                            {% endif %}
                                        </button>
                                    </div>
                                {% endfor %}
                            </div>
                        {% endif %}
                    </div>
                {% else %}
                    <div class="bg-light border rounded d-flex align-items-center justify-content-center"
                         style="height: 420px;">
                        <span class="text-muted">Brak zdjęć produktu</span>
                    </div>
                {% endif %}
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-header bg-light">
                <h2 class="h5 mb-0">Informacje o produkcie</h2>
            </div>

            <div class="card-body">
                <div class="mb-3">
                    <span class="badge bg-light text-dark border">
                        {{ product.category.name }}
                    </span>
                </div>

                <dl class="row mb-0">
                    <dt class="col-sm-3">Nazwa</dt>
                    <dd class="col-sm-9">{{ product.name }}</dd>

                    <dt class="col-sm-3">SKU</dt>
                    <dd class="col-sm-9">{{ product.sku }}</dd>

                    <dt class="col-sm-3">Opis</dt>
                    <dd class="col-sm-9">
                        {{ product.description ?: 'Brak opisu produktu.' }}
                    </dd>

                    <dt class="col-sm-3">Jednostka</dt>
                    <dd class="col-sm-9">{{ product.unit }}</dd>

                    <dt class="col-sm-3">Minimalna ilość</dt>
                    <dd class="col-sm-9">{{ product.minimumOrderQuantity }}</dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card shadow-sm">
            <div class="card-header bg-light">
                <h2 class="h5 mb-0">Cena</h2>
            </div>

            <div class="card-body">
                <div class="mb-3">
                    <div class="text-muted">Cena netto</div>
                    <div class="h3 mb-0">
                        {{ product.priceNet|number_format(2, ',', ' ') }} zł
                    </div>
                </div>

                <dl class="row mb-0">
                    <dt class="col-6">VAT</dt>
                    <dd class="col-6 text-end">{{ product.vatRate }}%</dd>

                    <dt class="col-6">Jednostka</dt>
                    <dd class="col-6 text-end">{{ product.unit }}</dd>

                    <dt class="col-6">Min. ilość</dt>
                    <dd class="col-6 text-end">{{ product.minimumOrderQuantity }}</dd>
                </dl>

                <button class="btn btn-primary w-100 mt-4" disabled>
                    Dodaj do koszyka
                </button>
            </div>
        </div>
    </div>
</div>

{% if images|length > 0 %}
    <div class="modal fade" id="productGalleryModal" tabindex="-1" aria-labelledby="productGalleryModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title h5" id="productGalleryModalLabel">
                        {{ product.name }}
                    </h2>

                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Zamknij"></button>
                </div>

                <div class="modal-body">
                    <div id="productGalleryCarousel" class="carousel slide">
                        <div class="carousel-inner">
                            {% for image in images %}
                                <div class="carousel-item {% if loop.first %}active{% endif %}">
                                    <div class="d-flex align-items-center justify-content-center bg-white"
                                        style="height: 620px;">
                                        <img src="{{ asset('uploads/products/' ~ image.filename) }}"
                                            class="d-block w-100 rounded"
                                            alt="{{ image.description ?: product.name }}"
                                            style="height: 620px; object-fit: contain;">
                                    </div>

                                    <div class="text-center text-muted small mt-3 d-flex align-items-center justify-content-center"
                                        style="height: 24px;">
                                        {% if image.description %}
                                            {{ image.description }}
                                        {% else %}
                                            &nbsp;
                                        {% endif %}
                                    </div>
                                </div>
                            {% endfor %}
                        </div>

                        {% if images|length > 1 %}
                            <button class="carousel-control-prev"
                                    type="button"
                                    data-bs-target="#productGalleryCarousel"
                                    data-bs-slide="prev"
                                    style="width: 72px;">
                                <span class="bg-white text-dark rounded-circle shadow-sm d-flex align-items-center justify-content-center"
                                    aria-hidden="true"
                                    style="width: 42px; height: 42px; font-size: 32px; line-height: 1;">
                                    ‹
                                </span>
                                <span class="visually-hidden">Poprzednie</span>
                            </button>

                            <button class="carousel-control-next"
                                    type="button"
                                    data-bs-target="#productGalleryCarousel"
                                    data-bs-slide="next"
                                    style="width: 72px;">
                                <span class="bg-white text-dark rounded-circle shadow-sm d-flex align-items-center justify-content-center"
                                    aria-hidden="true"
                                    style="width: 42px; height: 42px; font-size: 32px; line-height: 1;">
                                    ›
                                </span>
                                <span class="visually-hidden">Następne</span>
                            </button>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const galleryModal = document.getElementById('productGalleryModal');
            const galleryCarousel = document.getElementById('productGalleryCarousel');

            if (!galleryModal || !galleryCarousel) {
                return;
            }

            const carousel = new bootstrap.Carousel(galleryCarousel, {
                interval: false,
                ride: false
            });

            document.querySelectorAll('[data-bs-target="#productGalleryModal"][data-bs-slide-to]').forEach(function (trigger) {
                trigger.addEventListener('click', function () {
                    const slideIndex = Number(this.getAttribute('data-bs-slide-to'));

                    galleryModal.addEventListener('shown.bs.modal', function handleShown() {
                        carousel.to(slideIndex);
                        galleryModal.removeEventListener('shown.bs.modal', handleShown);
                    });
                });
            });
        });
    </script>
{% endif %}
{% endblock %}