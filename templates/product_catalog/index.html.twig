{% extends 'base.html.twig' %}

{% block title %}Katalog produktów{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">Katalog produktów</h1>
        <p class="text-muted mb-0">
            Lista produktów dostępnych dla klientów B2B.
        </p>
    </div>
</div>

{% if products is empty %}
    <div class="alert alert-info">
        Brak dostępnych produktów w katalogu.
    </div>
{% else %}
    <div class="row g-4">
        {% for product in products %}
            <div class="col-md-6 col-lg-4">
                <div class="card shadow-sm h-100">
                    <div class="card-body d-flex flex-column">
                        <div class="mb-3">
                            <span class="badge bg-light text-dark border">
                                {{ product.category.name }}
                            </span>
                        </div>

                        <h2 class="h5 mb-2">
                            {{ product.name }}
                        </h2>

                        <p class="text-muted small mb-2">
                            SKU: {{ product.sku }}
                        </p>

                        <p class="text-muted flex-grow-1">
                            {{ product.description ?: 'Brak opisu produktu.' }}
                        </p>

                        <div class="border-top pt-3 mt-3">
                            <div class="d-flex justify-content-between">
                                <span class="text-muted">Cena netto</span>
                                <strong>{{ product.priceNet|number_format(2, ',', ' ') }} zł</strong>
                            </div>

                            <div class="d-flex justify-content-between">
                                <span class="text-muted">VAT</span>
                                <span>{{ product.vatRate }}%</span>
                            </div>

                            <div class="d-flex justify-content-between">
                                <span class="text-muted">Jednostka</span>
                                <span>{{ product.unit }}</span>
                            </div>

                            <div class="d-flex justify-content-between">
                                <span class="text-muted">Min. ilość</span>
                                <span>{{ product.minimumOrderQuantity }}</span>
                            </div>
                        </div>

                        <a href="{{ path('app_product_show', { id: product.id }) }}"
                        class="btn btn-outline-primary mt-3">
                            Szczegóły
                        </a>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
{% endif %}
{% endblock %}