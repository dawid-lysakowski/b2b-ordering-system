{% extends 'base.html.twig' %}

{% block title %}Panel administracyjny{% endblock %}

{% block body %}
<div class="mb-4">
    <h1 class="h3 mb-1">Panel administracyjny</h1>
    <p class="text-muted mb-0">
        Widok dostępny dla administratora oraz pracownika systemu.
    </p>
</div>

<div class="row g-3">
    <div class="col-md-6 col-lg-4">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h2 class="h5">Zgłoszenia rejestracyjne</h2>
                <p class="text-muted">
                    Przeglądaj zgłoszenia nowych klientów B2B oczekujące na weryfikację.
                </p>

                <a href="{{ path('app_admin_registration_requests') }}" class="btn btn-primary">
                    Otwórz
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-lg-4">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h2 class="h5">Firmy klientów B2B</h2>
                <p class="text-muted">
                    Przeglądaj firmy klientów utworzone po zaakceptowaniu zgłoszeń rejestracyjnych.
                </p>

                <a href="{{ path('app_admin_customer_companies') }}" class="btn btn-primary">
                    Otwórz
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-lg-4">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h2 class="h5">Kategorie produktów</h2>
                <p class="text-muted">
                    Dodawaj i edytuj kategorie wykorzystywane w katalogu produktów.
                </p>

                <a href="{{ path('app_admin_categories') }}" class="btn btn-primary">
                    Otwórz
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}