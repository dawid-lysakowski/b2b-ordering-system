{% extends 'base.html.twig' %}

{% block title %}Zgłoszenia rejestracyjne{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">Zgłoszenia rejestracyjne</h1>
        <p class="text-muted mb-0">
            Lista zgłoszeń rejestracyjnych klientów B2B.
        </p>
    </div>

    <a href="{{ path('app_admin') }}" class="btn btn-outline-secondary">
        Powrót
    </a>
</div>

<div class="d-flex flex-wrap gap-2 mb-3">
    <a href="{{ path('app_admin_registration_requests', { status: 'pending' }) }}"
       class="btn btn-sm {{ currentStatus == 'pending' ? 'btn-primary' : 'btn-outline-primary' }}">
        Oczekujące
    </a>

    <a href="{{ path('app_admin_registration_requests', { status: 'approved' }) }}"
       class="btn btn-sm {{ currentStatus == 'approved' ? 'btn-success' : 'btn-outline-success' }}">
        Zaakceptowane
    </a>

    <a href="{{ path('app_admin_registration_requests', { status: 'rejected' }) }}"
       class="btn btn-sm {{ currentStatus == 'rejected' ? 'btn-danger' : 'btn-outline-danger' }}">
        Odrzucone
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        {% if registrationRequests is empty %}
            <div class="alert alert-info mb-0">
                Brak zgłoszeń dla wybranego filtra.
            </div>
        {% else %}
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Firma</th>
                            <th>NIP</th>
                            <th>E-mail użytkownika</th>
                            <th>Status</th>
                            <th>Data utworzenia</th>
                            <th class="text-end">Akcje</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for request in registrationRequests %}
                            <tr>
                                <td>{{ request.id }}</td>
                                <td>{{ request.companyName }}</td>
                                <td>{{ request.taxNumber }}</td>
                                <td>{{ request.userEmail }}</td>
                                <td>
                                    {% if request.status == 'pending' %}
                                        <span class="badge bg-warning text-dark">Oczekujące</span>
                                    {% elseif request.status == 'approved' %}
                                    {% if request.matchedCustomerCompany %}
                                        <span class="badge bg-success">
                                            Istniejąca firma
                                        </span>
                                    {% else %}
                                        <span class="badge bg-success">
                                            Zaakceptowane
                                        </span>
                                    {% endif %}
                                    {% elseif request.status == 'rejected' %}
                                        <span class="badge bg-danger">Odrzucone</span>
                                    {% else %}
                                        <span class="badge bg-secondary">{{ request.status }}</span>
                                    {% endif %}
                                </td>
                                <td>
                                    {{ request.createdAt ? request.createdAt|date('d.m.Y H:i') : '-' }}
                                </td>
                                <td class="text-end">
                                    <a href="{{ path('app_admin_registration_request_show', { id: request.id }) }}"
                                    class="btn btn-sm btn-outline-primary">
                                        Szczegóły
                                    </a>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}