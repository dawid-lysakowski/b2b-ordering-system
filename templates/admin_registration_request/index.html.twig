{% extends 'base.html.twig' %}

{% block title %}Zgłoszenia rejestracyjne{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">Zgłoszenia rejestracyjne</h1>
        <p class="text-muted mb-0">
            Lista zgłoszeń klientów B2B oczekujących na weryfikację.
        </p>
    </div>

    <a href="{{ path('app_admin') }}" class="btn btn-outline-secondary">
        Powrót
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        {% if registrationRequests is empty %}
            <div class="alert alert-info mb-0">
                Brak zgłoszeń oczekujących na weryfikację.
            </div>
        {% else %}
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Firma</th>
                            <th>NIP</th>
                            <th>E-mail użytkownika</th>
                            <th>Status</th>
                            <th>Data utworzenia</th>
                            <th class="text-end">Akcje</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for request in registrationRequests %}
                            <tr>
                                <td>{{ request.id }}</td>
                                <td>{{ request.companyName }}</td>
                                <td>{{ request.taxNumber }}</td>
                                <td>{{ request.userEmail }}</td>
                                <td>
                                    <span class="badge bg-warning text-dark">
                                        {{ request.status }}
                                    </span>
                                </td>
                                <td>
                                    {{ request.createdAt ? request.createdAt|date('d.m.Y H:i') : '-' }}
                                </td>
                                <td class="text-end">
                                    <a href="{{ path('app_admin_registration_request_show', { id: request.id }) }}"
                                    class="btn btn-sm btn-outline-primary">
                                        Szczegóły
                                    </a>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}