{% extends 'base.html.twig' %}

{% block title %}Mój profil{% endblock %}

{% block body %}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">
            Mój profil
        </h1>

        <p class="text-muted mb-0">
            Dane użytkownika oraz firmy.
        </p>
    </div>
</div>

<div class="row g-4">

    <div class="col-lg-6">

        <div class="card shadow-sm h-100">

            <div class="card-header bg-light">
                <h2 class="h5 mb-0">
                    Dane użytkownika
                </h2>
            </div>

            <div class="card-body">

                <dl class="row mb-0">

                    <dt class="col-sm-4">Imię</dt>
                    <dd class="col-sm-8">{{ user.firstName }}</dd>

                    <dt class="col-sm-4">Nazwisko</dt>
                    <dd class="col-sm-8">{{ user.lastName }}</dd>

                    <dt class="col-sm-4">E-mail</dt>
                    <dd class="col-sm-8">{{ user.email }}</dd>

                    <dt class="col-sm-4">Status</dt>
                    <dd class="col-sm-8">
                        {% if user.isActive %}
                            <span class="badge bg-success">Aktywny</span>
                        {% else %}
                            <span class="badge bg-secondary">Nieaktywny</span>
                        {% endif %}
                    </dd>

                    <dt class="col-sm-4">Utworzono</dt>
                    <dd class="col-sm-8">
                        {{ user.createdAt|date('Y-m-d H:i') }}
                    </dd>

                </dl>

            </div>

        </div>

    </div>

    <div class="col-lg-6">

        <div class="card shadow-sm h-100">

            <div class="card-header bg-light">
                <h2 class="h5 mb-0">
                    Dane firmy
                </h2>
            </div>

            <div class="card-body">

                <dl class="row mb-0">

                    <dt class="col-sm-4">Nazwa</dt>
                    <dd class="col-sm-8">{{ user.company.name }}</dd>

                    <dt class="col-sm-4">NIP</dt>
                    <dd class="col-sm-8">{{ user.company.taxNumber }}</dd>

                    <dt class="col-sm-4">E-mail</dt>
                    <dd class="col-sm-8">{{ user.company.email }}</dd>

                    <dt class="col-sm-4">Telefon</dt>
                    <dd class="col-sm-8">
                        {{ user.company.phone ?: '-' }}
                    </dd>

                </dl>

            </div>

        </div>

    </div>

</div>

<div class="row g-4 mt-1">

    <div class="col-12">

        <div class="card shadow-sm">

            <div class="card-header bg-light">
                <h2 class="h5 mb-0">
                    Adresy
                </h2>
            </div>

            <div class="card-body">

                <div class="row">

                    {% for address in user.company.addresses %}

                        <div class="col-md-6 mb-3">

                            <div class="border rounded p-3 h-100">

                                <h3 class="h6">

                                    {% if address.addressType == 'both' %}
                                        Adres rozliczeniowy i dostawy
                                    {% elseif address.addressType == 'billing' %}
                                        Adres rozliczeniowy
                                    {% else %}
                                        Adres dostawy
                                    {% endif %}

                                </h3>

                                <div>
                                    {{ address.street }}
                                    {{ address.buildingNumber }}{% if address.apartmentNumber %}/{{ address.apartmentNumber }}{% endif %}
                                </div>

                                <div>
                                    {{ address.postalCode }}
                                    {{ address.city }}
                                </div>

                                <div>
                                    {{ address.country }}
                                </div>

                            </div>

                        </div>

                    {% else %}

                        <div class="col-12">
                            <div class="alert alert-info mb-0">
                                Brak zapisanych adresów.
                            </div>
                        </div>

                    {% endfor %}

                </div>

            </div>

        </div>

    </div>

</div>

<div class="row g-4 mt-1">

    <div class="col-12">

        <div class="card shadow-sm">

            <div class="card-header bg-light">
                <h2 class="h5 mb-0">
                    Użytkownicy firmy
                </h2>
            </div>

            <div class="card-body">

                {% if user.company.users is empty %}

                    <div class="alert alert-info mb-0">
                        Brak użytkowników.
                    </div>

                {% else %}

                    <div class="table-responsive">

                        <table class="table table-hover align-middle mb-0">

                            <thead>

                                <tr>
                                    <th>Imię</th>
                                    <th>Nazwisko</th>
                                    <th>E-mail</th>
                                    <th>Status</th>
                                </tr>

                            </thead>

                            <tbody>

                                {% for companyUser in user.company.users %}

                                    <tr>

                                        <td>{{ companyUser.firstName }}</td>

                                        <td>{{ companyUser.lastName }}</td>

                                        <td>{{ companyUser.email }}</td>

                                        <td>

                                            {% if companyUser.isActive %}
                                                <span class="badge bg-success">
                                                    Aktywny
                                                </span>
                                            {% else %}
                                                <span class="badge bg-secondary">
                                                    Nieaktywny
                                                </span>
                                            {% endif %}

                                        </td>

                                    </tr>

                                {% endfor %}

                            </tbody>

                        </table>

                    </div>

                {% endif %}

            </div>

        </div>

    </div>

</div>

{% endblock %}