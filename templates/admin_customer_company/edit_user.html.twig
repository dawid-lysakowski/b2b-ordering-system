{% extends 'base.html.twig' %}

{% block title %}Edycja użytkownika klienta{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-lg-7 col-xl-6">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="h3 mb-1">Edycja użytkownika klienta</h1>
                <p class="text-muted mb-0">
                    Aktualizacja podstawowych danych użytkownika przypisanego do firmy {{ customerCompany.name }}.
                </p>
            </div>

            <a href="{{ path('app_admin_customer_company_show', { id: customerCompany.id }) }}"
               class="btn btn-outline-secondary">
                Powrót
            </a>
        </div>

        <div class="card shadow-sm">
            <div class="card-body">
                <div class="alert alert-light border mb-4">
                    <strong>Firma:</strong> {{ customerCompany.name }}<br>
                    <strong>Rola użytkownika:</strong> ROLE_CLIENT
                </div>

                {{ form_start(form) }}

                <div class="mb-3">
                    {{ form_row(form.firstName) }}
                </div>

                <div class="mb-3">
                    {{ form_row(form.lastName) }}
                </div>

                <div class="mb-3">
                    {{ form_row(form.email) }}
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a href="{{ path('app_admin_customer_company_show', { id: customerCompany.id }) }}"
                       class="btn btn-outline-secondary">
                        Anuluj
                    </a>

                    <button type="submit" class="btn btn-primary">
                        Zapisz zmiany
                    </button>
                </div>

                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}