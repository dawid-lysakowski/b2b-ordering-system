{% extends 'base.html.twig' %}

{% block title %}Edycja adresu firmy{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-lg-7 col-xl-6">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="h3 mb-1">Edycja adresu firmy</h1>
                <p class="text-muted mb-0">
                    Aktualizacja adresu przypisanego do firmy {{ customerCompany.name }}.
                </p>
            </div>

            <a href="{{ path('app_admin_customer_company_show', { id: customerCompany.id }) }}"
               class="btn btn-outline-secondary">
                Powrót
            </a>
        </div>

        <div class="card shadow-sm">
            <div class="card-body">
                <div class="alert alert-light border mb-4">
                    <strong>Typ adresu:</strong>
                    {% if address.addressType == 'billing' %}
                        adres rozliczeniowy
                    {% elseif address.addressType == 'delivery' %}
                        adres dostawy
                    {% elseif address.addressType == 'both' %}
                        adres rozliczeniowy i dostawy
                    {% else %}
                        adres
                    {% endif %}
                </div>

                {{ form_start(form) }}

                <div class="row g-3">
                    <div class="col-md-7">
                        {{ form_row(form.street) }}
                    </div>

                    <div class="col-md-3">
                        {{ form_row(form.buildingNumber) }}
                    </div>

                    <div class="col-md-2">
                        {{ form_row(form.apartmentNumber) }}
                    </div>

                    <div class="col-md-4">
                        {{ form_row(form.postalCode) }}
                    </div>

                    <div class="col-md-5">
                        {{ form_row(form.city) }}
                    </div>

                    <div class="col-md-3">
                        {{ form_row(form.country) }}
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a href="{{ path('app_admin_customer_company_show', { id: customerCompany.id }) }}"
                       class="btn btn-outline-secondary">
                        Anuluj
                    </a>

                    <button type="submit" class="btn btn-primary">
                        Zapisz zmiany
                    </button>
                </div>

                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}