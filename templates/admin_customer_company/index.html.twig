{% extends 'base.html.twig' %}

{% block title %}Firmy klientów B2B{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">Firmy klientów B2B</h1>
        <p class="text-muted mb-0">
            Lista firm utworzonych po zaakceptowaniu zgłoszeń rejestracyjnych.
        </p>
    </div>

    <a href="{{ path('app_admin') }}" class="btn btn-outline-secondary">
        Powrót
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        {% if customerCompanies is empty %}
            <div class="alert alert-info mb-0">
                Brak zarejestrowanych firm klientów B2B.
            </div>
        {% else %}
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Nazwa firmy</th>
                            <th>NIP</th>
                            <th>E-mail</th>
                            <th>Telefon</th>
                            <th>Status</th>
                            <th>Data utworzenia</th>
                            <th class="text-end">Akcje</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for company in customerCompanies %}
                            <tr>
                                <td>{{ company.id }}</td>
                                <td>{{ company.name }}</td>
                                <td>{{ company.taxNumber }}</td>
                                <td>{{ company.email }}</td>
                                <td>{{ company.phone }}</td>
                                <td>
                                    {% if company.isActive %}
                                        <span class="badge bg-success">Aktywna</span>
                                    {% else %}
                                        <span class="badge bg-secondary">Nieaktywna</span>
                                    {% endif %}
                                </td>
                                <td>
                                    {{ company.createdAt ? company.createdAt|date('d.m.Y H:i') : '-' }}
                                </td>
                                <td class="text-end">
                                    <a href="{{ path('app_admin_customer_company_show', { id: company.id }) }}"
                                    class="btn btn-sm btn-outline-primary">
                                        Szczegóły
                                    </a>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}