<div class="card shadow-sm mb-4">
    <div class="card-body">

        <form method="get">

            <div class="row g-3 align-items-end">

                <div class="col-lg-5">
                    <label class="form-label">
                        Nazwa lub SKU
                    </label>

                    <input
                        type="text"
                        name="search"
                        class="form-control"
                        placeholder="Wyszukaj produkt..."
                        value="{{ search }}"
                    >
                </div>

                <div class="col-lg-3">
                    <label class="form-label">
                        Kategoria
                    </label>

                    <select
                        name="category"
                        class="form-select"
                    >
                        <option value="">
                            Wszystkie
                        </option>

                        {% for category in categories %}
                            <option
                                value="{{ category.id }}"
                                {% if selectedCategory and selectedCategory.id == category.id %}
                                    selected
                                {% endif %}
                            >
                                {{ category.name }}
                            </option>
                        {% endfor %}
                    </select>
                </div>

                <div class="col-lg-1">
                    <label class="form-label">
                        Cena od
                    </label>

                    <input
                        type="number"
                        name="minPrice"
                        class="form-control"
                        step="0.01"
                        min="0"
                        placeholder="0"
                        value="{{ minPrice }}"
                    >
                </div>

                <div class="col-lg-1">
                    <label class="form-label">
                        Cena do
                    </label>

                    <input
                        type="number"
                        name="maxPrice"
                        class="form-control"
                        step="0.01"
                        min="0"
                        placeholder="1000"
                        value="{{ maxPrice }}"
                    >
                </div>

                <div class="col-lg-2">
                    <div class="btn-group w-100">

                        <button
                            type="submit"
                            class="btn btn-primary"
                        >
                            Szukaj
                        </button>

                        <a
                            href="{{ app.request.pathInfo }}"
                            class="btn btn-outline-secondary"
                        >
                            Reset
                        </a>

                    </div>
                </div>

            </div>

        </form>

    </div>
</div>